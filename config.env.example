# Свой секретный ключ для защиты сервера — придумай любую длинную случайную
# строку (например, сгенерируй командой: python3 -c "import secrets; print(secrets.token_hex(32))")
API_KEY=

# Порт для HTTP. Если Bothost сам прокидывает порт через переменную PORT —
# он её и так подставит, менять не обязательно.
PORT=8000

# Whisper: tiny/base/small/medium/large-v3. "base" — баланс для 1 ГБ RAM.
WHISPER_MODEL_SIZE=base

# Таймаут на распознавание одного 10-минутного куска (сек).
WHISPER_SUBPROCESS_TIMEOUT=900

# Не обязательно — только если YouTube начнёт блокировать скачивание.
COOKIES_FILE=

DOWNLOADS_DIR=downloads
